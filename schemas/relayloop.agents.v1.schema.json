{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DylanZhangzzz/RelayLoop/main/schemas/relayloop.agents.v1.schema.json",
  "title": "RelayLoop agents registry v1",
  "description": "relay-loop/agents.json: the role registry for a RelayLoop project. A PM agent entry is mandatory.",
  "type": "object",
  "required": ["schema", "project", "agents"],
  "properties": {
    "schema": {
      "const": "relayloop.agents.v1"
    },
    "project": {
      "type": "object",
      "required": ["name", "projectPath", "projectId", "createdAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "projectPath": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "adapter": { "enum": ["codex", "claude-code"] }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "role": { "const": "pm" } },
        "required": ["role"]
      },
      "items": {
        "type": "object",
        "required": ["role", "name", "status", "workspaceMode", "profilePath"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "threadId": { "type": ["string", "null"] },
          "hostId": { "type": ["string", "null"] },
          "status": { "type": "string", "minLength": 1 },
          "workspaceMode": { "enum": ["coordinator", "worktree", "readonly"] },
          "profilePath": { "type": "string", "minLength": 1 },
          "subagentPath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
